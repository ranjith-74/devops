    {
      "id": 11,
      "title": "HTTP 5xx Error Rate (%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentage of requests returning HTTP 5xx errors",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "((sum(rate(flask_http_requests_total{status=~\"5..\"}[1m])) or sum(rate(flask_http_requests_total{endpoint=~\"/api/simulate-error\"}[1m])) or vector(0)) / (sum(rate(flask_http_requests_total[1m])) > 0)) * 100 or vector(0)",
          "legendFormat": "5xx Rate",
          "range": true,
          "refId": "A"
        }
      ]
    },
