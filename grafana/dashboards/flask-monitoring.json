        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(flask_http_requests_total{status=~\"5..\"}[30s])) or sum(rate(flask_http_requests_total{endpoint=~\"/api/simulate-error\"}[30s])) or vector(0)",
          "legendFormat": "5xx Server Errors/sec",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
